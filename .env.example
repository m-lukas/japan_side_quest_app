# Long, different UUIDv4 values. Do not commit production values.
DANIEL_TOKEN=11111111-1111-4111-8111-111111111111
ADMIN_TOKEN=22222222-2222-4222-8222-222222222222

# Secret GitHub Gist containing one JSON file, e.g. japan-side-quest.json
GITHUB_GIST_ID=
# Fine-grained GitHub Personal Access Token with Gists read/write permission.
# Stored only in Vercel/.env.local - never expose it to the browser.
GITHUB_TOKEN=
GIST_FILENAME=japan-side-quest.json
